# NGINX front door (patch 8c). Rendered by scripts/ops_services.py render. Listens on this computer only.
# /api/ goes to the gateway (not straight to FastAPI). The developer monitoring path is never served here: use the gateway directly on this computer.
worker_processes 1;
error_log logs/error.log crit;
pid logs/nginx.pid;
events { worker_connections 256; }
http {
  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  server_tokens off;
  access_log off;
  limit_req_zone $binary_remote_addr zone=perip:1m rate=20r/s;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  upstream gateway_up { server 127.0.0.1:{{GATEWAY_PORT}}; keepalive 8; }
  server {
    listen 127.0.0.1:{{NGINX_PORT}};
    server_name localhost;
    client_max_body_size 5m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    location = /nginx-health { default_type text/plain; return 200 "ok"; }
    location ^~ /__monitor/ { return 404; }
    location /api/ {
      limit_req zone=perip burst=40 nodelay;
      proxy_pass http://gateway_up;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_read_timeout 180s;
    }
{{CLIENT_BLOCK}}
  }
}
