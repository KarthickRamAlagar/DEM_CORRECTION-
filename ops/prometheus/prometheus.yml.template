# Prometheus (patch 8c). Rendered by scripts/ops_services.py render into ops/_rendered/ (that folder holds the monitor secret and is ignored by git).
global:
  scrape_interval: 15s
  evaluation_interval: 15s
scrape_configs:
  - job_name: gateway
    metrics_path: /__monitor/{{MONITOR_SECRET}}/metrics
    static_configs:
      - targets: ["127.0.0.1:{{GATEWAY_PORT}}"]
{{EXTRA_JOBS}}
