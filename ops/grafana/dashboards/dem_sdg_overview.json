{
 "uid": "dem-sdg-overview",
 "title": "DEM-SDG overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "dem-sdg"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Extra services answering",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(dem_service_up)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Scrape targets up",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Gateway memory",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gw_process_resident_memory_bytes"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Memory available (computer)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "windows_memory_available_bytes"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Service up (1 = answering)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dem_service_up",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Gateway requests per second",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(gw_http_request_duration_seconds_count[2m]))",
     "legendFormat": "requests/s"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Gateway latency p95",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(gw_http_request_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Cache lookups",
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(gw_cache_total[5m])) by (result)",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "CPU in use (computer, %)",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - avg(rate(windows_cpu_time_total{mode=\"idle\"}[2m])) * 100",
     "legendFormat": "CPU"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Errors talking to the analysis service",
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "dem-prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(gw_upstream_errors_total[5m])",
     "legendFormat": "errors"
    }
   ]
  }
 ]
}